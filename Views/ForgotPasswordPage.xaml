<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             xmlns:helpers="clr-namespace:Become.Helpers"
             xmlns:vm="clr-namespace:Become.ViewModels"
             x:Class="Become.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,24" Spacing="0">

            <Label Text="←  Retour à la connexion"
                   FontFamily="InterSemibold"
                   TextColor="{StaticResource Primary}"
                   Padding="0,12"
                   HorizontalOptions="Start"
                   SemanticProperties.Description="Retour à la connexion">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Image Source="become_logo.png" HeightRequest="130" HorizontalOptions="Center"
                   Aspect="AspectFit" Margin="0,16,0,0"
                   SemanticProperties.Description="Logo Become" />

            <Label Text="Mot de passe oublié ?"
                   Style="{StaticResource Title}"
                   SemanticProperties.HeadingLevel="Level1"
                   Margin="0,24,0,8" />

            <!-- État : formulaire -->
            <VerticalStackLayout IsVisible="{Binding IsNotSent}" Spacing="0">
                <Label Text="Indiquez l'adresse e-mail associée à votre compte. Nous vous enverrons un lien pour réinitialiser votre mot de passe."
                       Style="{StaticResource BodySecondary}" />

                <Border IsVisible="{Binding HasGlobalError}"
                        BackgroundColor="{StaticResource ErrorTint}"
                        StrokeThickness="0" Padding="16,12" Margin="0,24,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="{Binding GlobalError}" Style="{StaticResource ErrorText}" />
                </Border>

                <controls:FormField Title="Adresse e-mail"
                                    Icon="{x:Static helpers:Icons.Mail}"
                                    Placeholder="vous@exemple.com"
                                    InputKeyboard="Email"
                                    Text="{Binding Email}"
                                    ErrorMessage="{Binding EmailError}"
                                    Margin="0,24,0,0" />

                <Button Text="{Binding ButtonText}"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0" />

                <Label Text="Pensez à vérifier vos courriers indésirables."
                       Style="{StaticResource Caption}"
                       TextColor="{StaticResource Secondary}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />
            </VerticalStackLayout>

            <!-- État : lien envoyé -->
            <Border IsVisible="{Binding IsSent}" Style="{StaticResource Card}" Margin="0,16,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✓  Lien envoyé" Style="{StaticResource H2}"
                           TextColor="{StaticResource Success}" />
                    <Label Text="{Binding SentMessage}" Style="{StaticResource BodySecondary}" />
                    <Button Text="Retour à la connexion"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="🛡  Vos objectifs restent personnels."
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
