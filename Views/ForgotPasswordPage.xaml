<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             xmlns:helpers="clr-namespace:Become.Helpers"
             xmlns:vm="clr-namespace:Become.ViewModels"
             x:Class="Become.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,24" Spacing="0">

            <!-- Retour -->
            <HorizontalStackLayout Spacing="6"
                                   HorizontalOptions="Start"
                                   Padding="0,12"
                                   SemanticProperties.Description="Retour à la connexion">
                <Label Text="{x:Static helpers:AppIcons.ArrowBack}"
                       Style="{StaticResource IconLabel}"
                       TextColor="{StaticResource Primary}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Text="Retour à la connexion"
                       FontFamily="InterSemibold"
                       FontSize="14"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <controls:AuthHeader Title="{Binding HeaderTitle}"
                                 Subtitle="{Binding HeaderSubtitle}"
                                 Margin="0,16,0,0" />

            <!-- État : formulaire -->
            <Border Style="{StaticResource AuthCard}"
                    IsVisible="{Binding IsNotSent}"
                    Margin="0,32,0,0">
                <VerticalStackLayout Spacing="20">

                    <controls:InlineBanner Kind="Error"
                                           Message="{Binding GlobalError}"
                                           IsVisible="{Binding HasGlobalError}" />

                    <controls:FormField Title="Adresse e-mail"
                                        Icon="{x:Static helpers:AppIcons.Mail}"
                                        Placeholder="vous@exemple.com"
                                        InputKeyboard="Email"
                                        Text="{Binding Email}"
                                        ErrorMessage="{Binding EmailError}" />

                    <Button Text="{Binding ButtonText}"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButton}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="{x:Static helpers:AppIcons.Info}"
                               Style="{StaticResource IconLabel}"
                               FontSize="16"
                               TextColor="{StaticResource TextMuted}"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="Pensez à vérifier vos courriers indésirables."
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- État : lien envoyé -->
            <Border Style="{StaticResource AuthCard}"
                    IsVisible="{Binding IsSent}"
                    Margin="0,32,0,0">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Fill">

                    <Border HorizontalOptions="Center"
                            WidthRequest="64" HeightRequest="64"
                            BackgroundColor="{StaticResource SuccessTint}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32" />
                        </Border.StrokeShape>
                        <Label Text="{x:Static helpers:AppIcons.MarkEmailRead}"
                               Style="{StaticResource IconLabel}"
                               FontSize="30"
                               TextColor="{StaticResource Success}"
                               AutomationProperties.IsInAccessibleTree="False" />
                    </Border>

                    <Label Text="{Binding SentMessage}"
                           Style="{StaticResource BodySecondary}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.3" />

                    <Button Text="Retour à la connexion"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,32,0,0">
                <Label Text="{x:Static helpers:AppIcons.Shield}"
                       Style="{StaticResource IconLabel}"
                       FontSize="16"
                       TextColor="{StaticResource TextMuted}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Text="Vos objectifs restent personnels."
                       Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>