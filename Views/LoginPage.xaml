<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             xmlns:helpers="clr-namespace:Become.Helpers"
             xmlns:vm="clr-namespace:Become.ViewModels"
             x:Class="Become.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,24" Spacing="0">

            <controls:AuthHeader Title="Heureux de vous revoir."
                                 Subtitle="Un petit pas aujourd'hui. Un grand changement demain." />

            <!-- Formulaire dans une carte : même langage visuel que le reste de l'application -->
            <Border Style="{StaticResource AuthCard}" Margin="0,32,0,0">
                <VerticalStackLayout Spacing="20">

                    <!-- Erreur globale (identifiants invalides, réseau) -->
                    <controls:InlineBanner Kind="Error"
                                           Message="{Binding GlobalError}"
                                           IsVisible="{Binding HasGlobalError}" />

                    <controls:FormField Title="Adresse e-mail"
                                        Icon="{x:Static helpers:AppIcons.Mail}"
                                        Placeholder="vous@exemple.com"
                                        InputKeyboard="Email"
                                        Text="{Binding Email}"
                                        ErrorMessage="{Binding EmailError}" />

                    <VerticalStackLayout Spacing="2">
                        <controls:FormField Title="Mot de passe"
                                            Icon="{x:Static helpers:AppIcons.Lock}"
                                            Placeholder="Votre mot de passe"
                                            IsPassword="True"
                                            Text="{Binding Password}"
                                            ErrorMessage="{Binding PasswordError}" />

                        <Label Text="Mot de passe oublié ?"
                               Style="{StaticResource LinkLabel}"
                               HorizontalOptions="End"
                               SemanticProperties.Description="Mot de passe oublié ? Ouvrir la récupération">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <Button Text="{Binding ButtonText}"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}" />

                    <!-- Séparateur -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
                        <BoxView Grid.Column="0" Style="{StaticResource Divider}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="ou" Style="{StaticResource Caption}" />
                        <BoxView Grid.Column="2" Style="{StaticResource Divider}" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Continuer avec Apple"
                            Command="{Binding AppleCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- Accès à l'inscription -->
            <Label HorizontalOptions="Center" Margin="0,16,0,0" Padding="0,12">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Nouveau sur Become ?  "
                              TextColor="{StaticResource TextSecondary}" />
                        <Span Text="Créer un compte"
                              FontFamily="InterSemibold"
                              TextColor="{StaticResource Primary}" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                <Label Text="{x:Static helpers:AppIcons.Shield}"
                       Style="{StaticResource IconLabel}"
                       FontSize="16"
                       TextColor="{StaticResource TextMuted}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Text="Vos objectifs restent personnels."
                       Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>