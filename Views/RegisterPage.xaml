<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             xmlns:helpers="clr-namespace:Become.Helpers"
             xmlns:vm="clr-namespace:Become.ViewModels"
             x:Class="Become.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,24" Spacing="0">

            <controls:AuthHeader Title="Votre prochain chapitre."
                                 Subtitle="Créez votre compte et avancez à votre rythme." />

            <Border Style="{StaticResource AuthCard}" Margin="0,32,0,0">
                <VerticalStackLayout Spacing="20">

                    <!-- Erreur globale (réseau, serveur) -->
                    <controls:InlineBanner Kind="Error"
                                           Message="{Binding GlobalError}"
                                           IsVisible="{Binding HasGlobalError}" />

                    <controls:FormField Title="Prénom"
                                        Icon="{x:Static helpers:AppIcons.Person}"
                                        Placeholder="Votre prénom"
                                        Text="{Binding FirstName}"
                                        ErrorMessage="{Binding FirstNameError}" />

                    <controls:FormField Title="Adresse e-mail"
                                        Icon="{x:Static helpers:AppIcons.Mail}"
                                        Placeholder="vous@exemple.com"
                                        InputKeyboard="Email"
                                        Text="{Binding Email}"
                                        ErrorMessage="{Binding EmailError}" />

                    <VerticalStackLayout Spacing="8">
                        <controls:FormField Title="Mot de passe"
                                            Icon="{x:Static helpers:AppIcons.Lock}"
                                            Placeholder="8 caractères minimum"
                                            IsPassword="True"
                                            Text="{Binding Password}"
                                            ErrorMessage="{Binding PasswordError}" />

                        <!-- Aide en temps réel : texte + symbole, jamais la couleur seule -->
                        <Label Text="{Binding PasswordHint}"
                               Style="{StaticResource Caption}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsPasswordOk}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsPasswordWeak}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Conditions d'utilisation -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding AcceptTerms}"
                                      Color="{StaticResource Primary}"
                                      VerticalOptions="Start"
                                      SemanticProperties.Description="J'accepte les conditions d'utilisation et la politique de confidentialité" />

                            <Label Grid.Column="1" VerticalOptions="Center" FontSize="14" LineHeight="1.3">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="J'accepte les "
                                              TextColor="{StaticResource TextSecondary}" />
                                        <Span Text="conditions d'utilisation"
                                              FontFamily="InterSemibold"
                                              TextColor="{StaticResource Primary}">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTermsTapped" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text=" et la "
                                              TextColor="{StaticResource TextSecondary}" />
                                        <Span Text="politique de confidentialité"
                                              FontFamily="InterSemibold"
                                              TextColor="{StaticResource Primary}">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="." TextColor="{StaticResource TextSecondary}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>

                        <controls:FieldError Message="{Binding TermsError}" />
                    </VerticalStackLayout>

                    <Button Text="{Binding ButtonText}"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- Retour à la connexion -->
            <Label HorizontalOptions="Center" Margin="0,16,0,0" Padding="0,12">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Déjà un compte ?  "
                              TextColor="{StaticResource TextSecondary}" />
                        <Span Text="Se connecter"
                              FontFamily="InterSemibold"
                              TextColor="{StaticResource Primary}" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
                <Label Text="{x:Static helpers:AppIcons.AutoAwesome}"
                       Style="{StaticResource IconLabel}"
                       FontSize="16"
                       TextColor="{StaticResource Primary}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Text="Pas besoin d'être parfait. Juste de commencer."
                       Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>