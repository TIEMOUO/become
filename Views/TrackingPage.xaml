<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             xmlns:helpers="clr-namespace:Become.Helpers"
             xmlns:vm="clr-namespace:Become.ViewModels"
             x:Class="Become.Views.TrackingPage"
             x:DataType="vm:TrackingViewModel"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <Grid RowDefinitions="*,Auto,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,16,24,24" Spacing="24">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Suivi du jour" Style="{StaticResource Title}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding DateTitle}" Style="{StaticResource BodySecondary}" />
                </VerticalStackLayout>

                <!-- Série + 7 derniers jours -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{x:Static helpers:Icons.Flame}" FontSize="22" VerticalOptions="Center" />
                            <Label Text="{Binding StreakText}" Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <FlexLayout JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Week}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayStatus">
                                    <VerticalStackLayout Spacing="6" WidthRequest="40">
                                        <Label Text="{Binding Letter}" Style="{StaticResource Caption}"
                                               HorizontalTextAlignment="Center" />
                                        <!-- Jour validé : disque plein + ✓ ; aujourd'hui : contour ; sinon : vide -->
                                        <Border WidthRequest="40" HeightRequest="40"
                                                BackgroundColor="{StaticResource PrimaryTint}"
                                                StrokeThickness="2" Stroke="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Number}" FontSize="14"
                                                   FontFamily="InterSemibold"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Text" Value="✓" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- État vide : aucun objectif actif -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoGoal}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Rien à suivre pour l'instant" Style="{StaticResource H2}" />
                        <Label Text="Créez un objectif pour retrouver ici vos actions du jour."
                               Style="{StaticResource BodySecondary}" />
                        <Button Text="+  Créer un objectif"
                                Command="{Binding CreateGoalCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- État vide : rien de prévu aujourd'hui -->
                <Label IsVisible="{Binding NothingDueToday}"
                       Text="Rien de prévu aujourd'hui. Profitez-en pour souffler."
                       Style="{StaticResource BodySecondary}" />

                <!-- Actions du jour -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding HasTasks}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="À faire aujourd'hui" Style="{StaticResource SectionTitle}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Grid.Column="1" Text="{Binding CounterText}"
                               FontFamily="InterSemibold" FontSize="14"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>

                    <Border IsVisible="{Binding AllDone}"
                            BackgroundColor="{StaticResource PrimaryTint}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label Text="✓  Journée accomplie. À demain !"
                               FontFamily="InterSemibold" TextColor="{StaticResource PrimaryDark}" />
                    </Border>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Tasks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskItem">
                                <Border Style="{StaticResource Card}" Padding="16"
                                        SemanticProperties.Description="{Binding AccessibleLabel}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTaskTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border WidthRequest="52" HeightRequest="52"
                                                BackgroundColor="{StaticResource PrimaryTint}" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icon}" FontSize="24"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>

                                        <!-- Case de validation (zone tactile 48) -->
                                        <Border Grid.Column="2" WidthRequest="48" HeightRequest="48"
                                                BackgroundColor="{StaticResource Surface}"
                                                Stroke="{StaticResource Stroke}" StrokeThickness="2"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="24" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding StateText}" TextColor="White"
                                                   FontFamily="InterBold" FontSize="20"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Touchez une ligne pour valider. Touchez-la encore pour annuler."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Retour d'action : sobre, disparaît seul -->
        <Border Grid.Row="1" IsVisible="{Binding HasFeedback}"
                BackgroundColor="{StaticResource PrimaryTint}" StrokeThickness="0"
                Margin="24,8,24,12" Padding="16,12"
                SemanticProperties.Description="{Binding Feedback}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Label Text="{Binding Feedback}" FontFamily="InterSemibold"
                   TextColor="{StaticResource PrimaryDark}" />
        </Border>

        <controls:BottomNavBar Grid.Row="2" ActiveTab="tracking" TabSelected="OnTabSelected" />
    </Grid>
</ContentPage>
