<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Become.Controls"
             x:Class="Become.Views.VisionQuestionnairePage"
             Style="{StaticResource BcPage}"
             Title="Ta vision">

    <Grid Background="{StaticResource BcNightBrush}" RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,24,24,16" Spacing="20">

                <controls:BecomeBackButton />

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding StepLabel}" Style="{StaticResource BcSectionLabel}" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource BcGlowTeal}" />
                </VerticalStackLayout>

                <Label Text="{Binding Question}"
                       Style="{StaticResource BcDarkTitle}" FontSize="26"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Hint}" Style="{StaticResource BcDarkBody}" />

                <Border Style="{StaticResource BcDarkField}" Padding="14,6">
                    <Editor Text="{Binding CurrentAnswer}"
                            Placeholder="Écris ici avec tes mots…"
                            Style="{StaticResource BcDarkEditor}" />
                </Border>

                <Label Text="{Binding Error}" Style="{StaticResource BcDarkError}"
                       IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="24,12,24,28">
            <Button Text="{Binding NextText}"
                    Style="{StaticResource BcGlowButton}"
                    Command="{Binding NextCommand}" />
            <Button Text="Étape précédente"
                    Style="{StaticResource BcLinkButton}"
                    Command="{Binding PreviousCommand}"
                    IsVisible="{Binding CanGoBack}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>