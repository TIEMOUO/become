<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Become.Controls"
             x:Class="Become.Views.ActionEditPage"
             Style="{StaticResource BcPage}"
             Title="Modifier l'action">

    <Grid Background="{StaticResource BcNightBrush}" RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,24,24,16" Spacing="18">

                <controls:BecomeBackButton />

                <Label Text="Modifier l'action" Style="{StaticResource BcDarkTitle}"
                       SemanticProperties.HeadingLevel="Level1" />

                <VerticalStackLayout Spacing="8">
                    <Label Text="Titre" Style="{StaticResource BcDarkLabel}" />
                    <Border Style="{StaticResource BcDarkField}">
                        <Entry Text="{Binding Title}" Style="{StaticResource BcDarkEntry}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Description (facultatif)" Style="{StaticResource BcDarkLabel}" />
                    <Border Style="{StaticResource BcDarkField}" Padding="14,6">
                        <Editor Text="{Binding Description}" MinimumHeightRequest="90"
                                Style="{StaticResource BcDarkEditor}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Durée estimée en minutes (facultatif)" Style="{StaticResource BcDarkLabel}" />
                    <Border Style="{StaticResource BcDarkField}">
                        <Entry Text="{Binding Minutes}" Keyboard="Numeric" Placeholder="Ex. : 15"
                               Style="{StaticResource BcDarkEntry}" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding Error}" Style="{StaticResource BcDarkError}"
                       IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="24,12,24,28">
            <Button Text="Enregistrer"
                    Style="{StaticResource BcGlowButton}"
                    Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>