<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Views.ProgressPage"
             Style="{StaticResource BcPage}"
             Title="Suivi">

    <Grid Background="{StaticResource BcNightBrush}">
        <ScrollView>
            <VerticalStackLayout Padding="24,36,24,24" Spacing="24">

                <Label Text="Ton suivi" Style="{StaticResource BcDarkTitle}"
                       SemanticProperties.HeadingLevel="Level1" />

                <!-- Actions réalisées -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="ACTIONS RÉALISÉES" Style="{StaticResource BcSectionLabel}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource BcDarkCard}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TotalDoneText}" FontSize="32" FontAttributes="Bold"
                                       TextColor="{StaticResource BcOnNight}" />
                                <Label Text="au total" Style="{StaticResource BcDarkLabel}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource BcDarkCard}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding WeekDoneText}" FontSize="32" FontAttributes="Bold"
                                       TextColor="{StaticResource BcOnNight}" />
                                <Label Text="sur 7 jours" Style="{StaticResource BcDarkLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Régularité -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="RÉGULARITÉ" Style="{StaticResource BcSectionLabel}" />
                    <Border Style="{StaticResource BcDarkCard}">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center"
                                                   BindableLayout.ItemsSource="{Binding WeekDays}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="6">
                                            <Border WidthRequest="36" HeightRequest="36"
                                                    StrokeShape="RoundRectangle 18"
                                                    Stroke="{StaticResource BcGlassBorder}" StrokeThickness="1"
                                                    BackgroundColor="Transparent">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource BcGlowTeal}" />
                                                        <Setter Property="Stroke" Value="{StaticResource BcGlowTeal}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <Label Text="{Binding Letter}" FontSize="13"
                                                   HorizontalOptions="Center"
                                                   TextColor="{StaticResource BcOnNightMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Label Text="{Binding RegularityText}" Style="{StaticResource BcDarkLabel}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Objectifs -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="PROGRESSION DES OBJECTIFS" Style="{StaticResource BcSectionLabel}" />

                    <Label Text="Aucun objectif pour le moment." Style="{StaticResource BcDarkBody}" FontSize="15">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasGoals}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding GoalRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BcDarkCard}">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Title}" Style="{StaticResource BcDarkHeading}" FontSize="16" />
                                        <ProgressBar Progress="{Binding Progress}"
                                                     ProgressColor="{StaticResource BcGlowTeal}" />
                                        <Label Text="{Binding StatusText}" Style="{StaticResource BcDarkLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding AchievedText}" Style="{StaticResource BcDarkLabel}" />
                    <Label Text="La progression est une estimation. Un objectif n'est « atteint » que lorsque tu le décides."
                           Style="{StaticResource BcDarkLabel}" FontAttributes="Italic" />
                </VerticalStackLayout>

                <!-- Historique -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="ACTIONS PRÉCÉDENTES" Style="{StaticResource BcSectionLabel}" />

                    <Label Text="Aucune action passée pour le moment." Style="{StaticResource BcDarkBody}" FontSize="15">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasHistory}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BcDarkCard}">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding DateLabel}"
                                                   Style="{StaticResource BcDarkHeading}" FontSize="16" />
                                            <Label Grid.Column="1" Text="{Binding Summary}"
                                                   Style="{StaticResource BcDarkLabel}" VerticalOptions="Center" />
                                        </Grid>

                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Entries}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <Border Grid.Column="0" WidthRequest="12" HeightRequest="12"
                                                                StrokeShape="RoundRectangle 6"
                                                                Stroke="{StaticResource BcGlassBorder}" StrokeThickness="1"
                                                                BackgroundColor="Transparent" VerticalOptions="Center">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource BcGlowTeal}" />
                                                                    <Setter Property="Stroke" Value="{StaticResource BcGlowTeal}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        </Border>
                                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="15"
                                                               TextColor="{StaticResource BcOnNight}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>