<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Views.GoalsPage"
             Style="{StaticResource BcPage}"
             Title="Objectifs">

    <Grid Background="{StaticResource BcNightBrush}">
        <ScrollView>
            <VerticalStackLayout Padding="24,36,24,24" Spacing="20">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Tes objectifs" Style="{StaticResource BcDarkTitle}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding CountText}" Style="{StaticResource BcDarkBody}" FontSize="15" />
                </VerticalStackLayout>

                <Border Style="{StaticResource BcDarkCard}" IsVisible="{Binding HasNoGoals}">
                    <Label Text="Tu n'as pas encore d'objectif actif. Ajoute-en un pour que BECOME te propose des actions."
                           TextColor="{StaticResource BcOnNight}" FontSize="16" />
                </Border>

                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Goals}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BcDarkCard}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Domain}" Style="{StaticResource BcSectionLabel}" />
                                    <Label Text="{Binding Title}" Style="{StaticResource BcDarkHeading}" />
                                    <Label Text="{Binding Description}" Style="{StaticResource BcDarkBody}" FontSize="15" />
                                    <Label Text="{Binding ExpectedResult}"
                                           TextColor="{StaticResource BcOnNight}" FontSize="15" />
                                    <Label Text="{Binding DueText}" Style="{StaticResource BcDarkLabel}"
                                           IsVisible="{Binding HasDue}" />

                                    <ProgressBar Progress="{Binding Progress}"
                                                 ProgressColor="{StaticResource BcGlowTeal}" Margin="0,6,0,0" />
                                    <Label Text="{Binding ProgressText}" Style="{StaticResource BcDarkLabel}" />

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                        <Button Grid.Column="0" Text="Modifier"
                                                Style="{StaticResource BcGhostButton}" FontSize="13" HeightRequest="44"
                                                Padding="0" Command="{Binding EditCommand}" />
                                        <Button Grid.Column="1" Text="Atteint"
                                                Style="{StaticResource BcGhostButton}" FontSize="13" HeightRequest="44"
                                                Padding="0" Command="{Binding AchieveCommand}" />
                                        <Button Grid.Column="2" Text="Archiver"
                                                Style="{StaticResource BcGhostButton}" FontSize="13" HeightRequest="44"
                                                Padding="0" Command="{Binding ArchiveCommand}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Ajouter un objectif"
                        Style="{StaticResource BcGlowButton}"
                        Command="{Binding AddGoalCommand}"
                        IsVisible="{Binding CanAdd}" />

                <Label Text="{Binding AchievedText}" Style="{StaticResource BcDarkLabel}"
                       IsVisible="{Binding HasAchieved}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>