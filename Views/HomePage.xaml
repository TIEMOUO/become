<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             xmlns:helpers="clr-namespace:Become.Helpers"
             xmlns:models="clr-namespace:Become.Models"
             xmlns:vm="clr-namespace:Become.ViewModels"
             x:Class="Become.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,16,24,24" Spacing="24">

                <!-- ===== En-tête ===== -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding DateText}"
                               Style="{StaticResource Caption}"
                               FontFamily="InterSemibold" />
                        <Label Text="{Binding Greeting}"
                               Style="{StaticResource Title}"
                               SemanticProperties.HeadingLevel="Level1" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="44" HeightRequest="44"
                            BackgroundColor="{StaticResource PrimaryTint}"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            SemanticProperties.Description="Mon compte">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Initial}"
                               FontFamily="InterSemibold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- ===== État : erreur de chargement ===== -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{StaticResource ErrorTint}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                        <Button Text="Réessayer"
                                Command="{Binding RetryCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="48" />
                    </VerticalStackLayout>
                </Border>

                <!-- ===== État : chargement (squelettes, aucune image) ===== -->
                <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="16"
                                     SemanticProperties.Description="Chargement en cours">
                    <Border Style="{StaticResource Skeleton}" HeightRequest="200" />
                    <Border Style="{StaticResource Skeleton}" HeightRequest="110" />
                    <Border Style="{StaticResource Skeleton}" HeightRequest="130" />
                    <Border Style="{StaticResource Skeleton}" HeightRequest="130" />
                </VerticalStackLayout>

                <!-- ===== État : vide (aucun objectif) ===== -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Aucun objectif pour l'instant" Style="{StaticResource H2}" />
                        <Label Text="Créez votre premier objectif : un petit pas suffit pour commencer."
                               Style="{StaticResource BodySecondary}" />
                        <Button Text="+  Créer un objectif"
                                Command="{Binding CreateGoalCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Contenu ===== -->
                <VerticalStackLayout IsVisible="{Binding ShowContent}" Spacing="24">

                    <!-- Synthèse : progression globale + série -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                <controls:ProgressRing Progress="{Binding OverallProgress}"
                                                       Caption="avancement"
                                                       WidthRequest="124"
                                                       HeightRequest="124" />
                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Label Text="Vous avancez, à votre rythme."
                                           Style="{StaticResource H2}" />
                                    <Label Text="{Binding SummaryText}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource Divider}" />

                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{x:Static helpers:Icons.Flame}"
                                       FontSize="20" VerticalOptions="Center" />
                                <Label Text="{Binding StreakText}" VerticalOptions="Center" />
                                <Label Text="Gardez l'élan !"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Aujourd'hui -->
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Un pas aujourd'hui"
                                   Style="{StaticResource SectionTitle}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Grid.Column="1"
                                   Text="{Binding TodayCounter}"
                                   FontFamily="InterSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Prochaine action à faire -->
                        <VerticalStackLayout Spacing="16" IsVisible="{Binding HasPendingToday}">
                            <HorizontalStackLayout Spacing="16">
                                <Label Text="{Binding TodayIcon}" FontSize="28" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding TodayTitle}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding TodaySubtitle}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Button Text="→  Ouvrir mon suivi du jour"
                                    Command="{Binding OpenTrackingCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </VerticalStackLayout>

                        <!-- Rien de prévu aujourd'hui -->
                        <Label IsVisible="{Binding NothingToday}"
                               Text="Rien de prévu aujourd'hui. Profitez-en pour souffler."
                               Style="{StaticResource BodySecondary}" />

                        <!-- Journée accomplie -->
                        <Border IsVisible="{Binding AllDoneToday}"
                                BackgroundColor="{StaticResource PrimaryTint}"
                                StrokeThickness="0"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="✓  Journée accomplie. À demain !"
                                   FontFamily="InterSemibold"
                                   TextColor="{StaticResource PrimaryDark}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Vos objectifs -->
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Vos objectifs"
                                   Style="{StaticResource SectionTitle}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Grid.Column="1"
                                   Text="{Binding GoalsLinkText}"
                                   FontFamily="InterSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}"
                                   Padding="0,8"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenGoalsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Spacing="16"
                                             BindableLayout.ItemsSource="{Binding Goals}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Goal">
                                    <Border Style="{StaticResource Card}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnGoalTapped" />
                                        </Border.GestureRecognizers>

                                        <Grid RowDefinitions="Auto,Auto,Auto"
                                              ColumnDefinitions="Auto,*,Auto"
                                              RowSpacing="14"
                                              ColumnSpacing="16">

                                            <Border WidthRequest="56" HeightRequest="56"
                                                    BackgroundColor="{StaticResource PrimaryTint}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Icon}"
                                                       FontSize="26"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="{x:Static helpers:Icons.Chevron}"
                                                   FontSize="28"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   VerticalOptions="Center" />

                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding ProgressText}"
                                                       Style="{StaticResource BodySecondary}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding PercentText}"
                                                       FontFamily="InterSemibold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Grid>

                                            <controls:LinearProgress Grid.Row="2" Grid.ColumnSpan="3"
                                                                     Progress="{Binding Progress}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1" ActiveTab="home" TabSelected="OnTabSelected" />
    </Grid>
</ContentPage>
