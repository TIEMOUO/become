<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Views.HomePage"
             Style="{StaticResource BcPage}"
             Title="Accueil">

    <Grid Background="{StaticResource BcNightBrush}">
        <ScrollView>
            <VerticalStackLayout Padding="24,36,24,24" Spacing="26">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Greeting}" Style="{StaticResource BcDarkTitle}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding DateText}" Style="{StaticResource BcDarkBody}" FontSize="15" />
                </VerticalStackLayout>

                <!-- 1. Où je veux aller -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="OÙ JE VEUX ALLER" Style="{StaticResource BcSectionLabel}" />
                    <Border Style="{StaticResource BcDarkCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding VisionText}"
                                   TextColor="{StaticResource BcOnNight}" FontSize="17" LineHeight="1.4" />
                            <Button Text="Modifier ma vision"
                                    Style="{StaticResource BcLinkButton}"
                                    HorizontalOptions="Start" Padding="0"
                                    Command="{Binding EditVisionCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. Sur quoi je travaille -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="SUR QUOI JE TRAVAILLE" Style="{StaticResource BcSectionLabel}" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Goals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BcDarkCard}">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Domain}" FontSize="12"
                                               TextColor="{StaticResource BcOnNightMuted}" />
                                        <Label Text="{Binding Title}" Style="{StaticResource BcDarkHeading}" />
                                        <ProgressBar Progress="{Binding Progress}"
                                                     ProgressColor="{StaticResource BcGlowTeal}" />
                                        <Label Text="{Binding ProgressText}" Style="{StaticResource BcDarkLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource BcDarkCard}" IsVisible="{Binding HasNoGoals}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Tu n'as pas encore d'objectif actif."
                                   TextColor="{StaticResource BcOnNight}" FontSize="16" />
                            <Button Text="Voir mes objectifs"
                                    Style="{StaticResource BcLinkButton}"
                                    HorizontalOptions="Start" Padding="0"
                                    Command="{Binding GoToGoalsCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Aujourd'hui -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="CE QUE JE PEUX FAIRE AUJOURD'HUI" Style="{StaticResource BcSectionLabel}" />

                    <Border Style="{StaticResource BcDarkCard}">
                        <VerticalStackLayout Spacing="14">

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasGoals}">
                                <Label Text="{Binding TodayText}" Style="{StaticResource BcDarkLabel}" />
                                <ProgressBar Progress="{Binding TodayProgress}"
                                             ProgressColor="{StaticResource BcGlowTeal}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding TodayActions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                                            <Border Grid.Column="0"
                                                    WidthRequest="44" HeightRequest="44"
                                                    StrokeShape="RoundRectangle 22"
                                                    Stroke="{StaticResource BcGlowTeal}" StrokeThickness="2"
                                                    BackgroundColor="Transparent"
                                                    VerticalOptions="Center"
                                                    SemanticProperties.Description="Marquer comme réalisée ou annuler">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource BcGlowTeal}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                      Fill="White" Aspect="Uniform"
                                                      WidthRequest="20" HeightRequest="20"
                                                      HorizontalOptions="Center" VerticalOptions="Center"
                                                      IsVisible="{Binding IsDone}" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                </Border.GestureRecognizers>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"
                                                       TextColor="{StaticResource BcOnNight}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding Subtitle}" FontSize="13"
                                                       TextColor="{StaticResource BcOnNightMuted}" />
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding EditCommand}" />
                                                </VerticalStackLayout.GestureRecognizers>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="Aucune action prévue aujourd'hui."
                                   TextColor="{StaticResource BcOnNightMuted}" FontSize="15"
                                   IsVisible="{Binding HasNoActions}" />
                            <Label Text="Active un objectif pour voir tes actions du jour."
                                   TextColor="{StaticResource BcOnNightMuted}" FontSize="15"
                                   IsVisible="{Binding HasNoGoals}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Touche le texte d'une action pour la modifier."
                           Style="{StaticResource BcDarkLabel}" FontAttributes="Italic" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>