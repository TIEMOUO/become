<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:Become.Controls"
             x:Class="Become.Controls.FormField"
             x:Name="Root">

    <VerticalStackLayout Spacing="8">

        <Label x:Name="TitleLabel"
               Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource FieldLabel}"
               IsVisible="False" />

        <Border x:Name="FieldFrame"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Stroke}"
                StrokeThickness="1.5"
                HeightRequest="54">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0,6,0">
                <Label x:Name="IconLabel"
                       Text="{Binding Icon, Source={x:Reference Root}}"
                       Style="{StaticResource IconLabel}"
                       TextColor="{StaticResource TextMuted}"
                       Margin="0,0,12,0"
                       IsVisible="False"
                       AutomationProperties.IsInAccessibleTree="False" />

                <Entry x:Name="Input"
                       Grid.Column="1"
                       Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                       Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                       Keyboard="{Binding InputKeyboard, Source={x:Reference Root}}"
                       SemanticProperties.Description="{Binding Title, Source={x:Reference Root}}"
                       BackgroundColor="Transparent"
                       FontFamily="InterRegular"
                       FontSize="16"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextMuted}"
                       VerticalOptions="Center"
                       Focused="OnFocused"
                       Unfocused="OnUnfocused" />

                <Label x:Name="RevealLabel"
                       Grid.Column="2"
                       Style="{StaticResource IconLabel}"
                       WidthRequest="44"
                       HeightRequest="44"
                       IsVisible="False"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRevealTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <controls:FieldError Message="{Binding ErrorMessage, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>