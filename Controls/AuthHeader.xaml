<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Become.Controls.AuthHeader"
             x:Name="Root">

    <VerticalStackLayout Spacing="0">
        <Image x:Name="Logo"
               Source="become_logo.png"
               HeightRequest="104"
               HorizontalOptions="Center"
               Aspect="AspectFit"
               SemanticProperties.Description="Logo Become" />

        <Label Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource Title}"
               HorizontalTextAlignment="Center"
               SemanticProperties.HeadingLevel="Level1"
               Margin="0,24,0,0" />

        <Label x:Name="SubtitleLabel"
               Text="{Binding Subtitle, Source={x:Reference Root}}"
               Style="{StaticResource BodySecondary}"
               HorizontalTextAlignment="Center"
               LineHeight="1.3"
               Margin="0,8,0,0" />
    </VerticalStackLayout>
</ContentView>